SAFEDB_API_URL=http://127.0.0.1:8080
SAFEDB_AGENT_TOKEN=replace-with-long-random-agent-token
SAFEDB_REVIEWER_TOKEN=replace-with-long-random-reviewer-token
SAFEDB_AGENT_ID=local-agent
SAFEDB_REVIEWER_ID=local-reviewer
SAFEDB_DB_PATH=./data/safedb.sqlite3
SAFEDB_DATASOURCES_FILE=./config/datasources.yaml

