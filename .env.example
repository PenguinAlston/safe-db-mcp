SAFEDB_API_URL=http://127.0.0.1:8080
SAFEDB_AGENT_TOKEN=replace-with-long-random-agent-token
SAFEDB_REVIEWER_TOKEN=replace-with-long-random-reviewer-token
SAFEDB_AGENT_ID=local-agent
SAFEDB_REVIEWER_ID=local-reviewer
SAFEDB_DB_PATH=./data/safedb.sqlite3
SAFEDB_DATASOURCES_FILE=./config/datasources.yaml

# Proposal store backend. Unset = local SQLite (development only).
# For production set a PostgreSQL URL, e.g.
#   postgresql+psycopg://safedb_app:REPLACE_ME@localhost:5432/safedb
# These are metadata-store credentials (proposals, audit, results),
# never datasource database URLs.
# SAFEDB_STORE_URL=

# Actual DB URLs must be injected into the worker only, never the API or MCP process.
# MYSQL8_URL=
# PG16_URL=
# ORACLE19C_URL=
